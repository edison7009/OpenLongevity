{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Longevity",
  "version": "0.0.2",
  "identifier": "science.openlongevity.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Longevity · 科学长寿",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Healthcare and Fitness",
    "shortDescription": "Scientific longevity notes and AI, grounded in your local library.",
    "longDescription": "Open Longevity is a local-first desktop app for reading longevity notes, capturing research, and asking an AI assistant grounded in your own knowledge library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
